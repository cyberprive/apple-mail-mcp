# apple-mail-mcp configuration. Every variable is optional.
# Set them in your MCP client's server config (`env`), or export them in the
# environment the server starts in.

# Folder that attachments may be saved into. save_attachment and
# save_all_attachments refuse any path outside it.
# Default: ~/Downloads/apple-mail-mcp
APPLE_MAIL_MCP_ATTACHMENTS_DIR=

# Default visibility for created drafts. "true" = Mail opens the compose
# window; "false" = the draft is saved silently to Drafts.
# Default: false
APPLE_MAIL_MCP_DRAFT_VISIBLE=false

# Timeout for a single osascript call, in milliseconds.
# Default: 45000 (45s). Measured on a ~30k-message iCloud inbox: a date- and
# unread-filtered search_messages took 12-19s; a cold iCloud reconnect can push
# a query past 30s. Raise it if you see TIMEOUT errors on very large mailboxes.
APPLE_MAIL_MCP_APPLESCRIPT_TIMEOUT_MS=45000

# Structured (JSON) log file.
# Default: ~/Library/Logs/apple-mail-mcp.log
APPLE_MAIL_MCP_LOG_PATH=

# DEBUG | INFO | WARNING | ERROR. Default: INFO
APPLE_MAIL_MCP_LOG_LEVEL=INFO
